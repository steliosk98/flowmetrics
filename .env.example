# Application
FLOWMETRICS_PORT=3000
TZ=Europe/Chisinau
AUTH_MODE=local
COOKIE_SECURE=false
STORE_RAW_PAYLOADS=false
LOG_LEVEL=info

# Collector: demo | ecoflow | off
#   demo     deterministic synthetic profile, no hardware needed
#   ecoflow  poll the EcoFlow IoT Open Platform (see below)
#   off      serve recorded history only, collect nothing
CONNECTOR=demo
# Legacy switch, still honoured when CONNECTOR is unset. DEMO_MODE=false means "off".
DEMO_MODE=true

# EcoFlow — required when CONNECTOR=ecoflow.
# Create the key pair at https://developer-eu.ecoflow.com (sign in with the same
# account the battery is bound to, then open the IoT Developer Platform).
# Verify them before starting the stack:  node scripts/ecoflow-probe.mjs
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=
# Comma-separated serials. Leave empty to record EVERY device bound to the
# account — each one gets its own device row, history and event stream.
ECOFLOW_SERIAL_NUMBER=
# Documented host. Override only if EcoFlow gives you a different regional endpoint.
ECOFLOW_HOST=https://api.ecoflow.com
# Transport: mqtt subscribes to the battery's own live reports (~1/sec, works with
# the phone app closed); poll reads EcoFlow's HTTP cache, which for an idle DELTA 2
# can be tens of minutes stale. MQTT falls back to polling automatically.
ECOFLOW_TRANSPORT=mqtt
# How often a reading is recorded from the live MQTT state.
ECOFLOW_SAMPLE_INTERVAL_MS=10000
# Used by the poll transport, and as the MQTT startup seed. EcoFlow publishes no
# rate limit, so this stays conservative.
ECOFLOW_POLL_INTERVAL_MS=30000
# EcoFlow's API returns no model, so state it here if you want one shown.
# Applies to every device. ECOFLOW_DEVICE_NAME only applies when a single
# device is bound; otherwise names come from the EcoFlow app.
ECOFLOW_DEVICE_MODEL=
ECOFLOW_DEVICE_NAME=

# PostgreSQL — choose a strong password before starting Compose.
POSTGRES_DB=flowmetrics
POSTGRES_USER=flowmetrics
POSTGRES_PASSWORD=change-me-before-starting
DATABASE_URL=postgresql://flowmetrics:change-me-before-starting@postgres:5432/flowmetrics

# Optional externally managed 32-byte encryption key, base64 encoded.
# If omitted, a key is generated inside the persistent flowmetrics_data volume.
APP_ENCRYPTION_KEY=
